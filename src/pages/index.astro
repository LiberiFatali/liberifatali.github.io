---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm LiberiFatali</div>
    <div class="text-3xl py-3 font-bold">Software Engineer — AI &amp; Backend</div>
    <div class="py-2">
      <text class="text-lg">
        I am a software engineer with over 13 years of professional experience, specializing in AI product
        development, backend systems, computer vision, and machine learning.
      </text>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Key Strengths</div>
  </div>

  <div class="grid md:grid-cols-3 gap-4">
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Computer Vision</h2>
        <p>Image/video processing, recognition, and model R&amp;D.</p>
      </div>
    </div>
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Backend</h2>
        <p>Scalable development on-premises and in the cloud (AWS, GCP...).</p>
      </div>
    </div>
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">RAG with LLM</h2>
        <p>Retrieval-Augmented Generation pipeline design and implementation.</p>
      </div>
    </div>
  </div>

  <div class="mt-10">
    <p class="text-justify text-lg">
      I bring a deep understanding of algorithms, data structures, and system design, combined with hands-on
      experience in delivering AI-powered products that bridge research and real-world applications.
    </p>
  </div>
</BaseLayout>