---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Tools</div>
  </div>

  <HorizontalCard
    title="Assistant for Vipassana at UCENLIST (Vietnam)"
    img="/simple_bw_sit.png"
    url="https://vipassana-assistant.vercel.app"
    badge="Tool"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="LinkedSpace - Expand LinkedIn messaging space"
    img="/linkedspace_icon_source.png"
    desc="Browser extension that expands the LinkedIn messaging area."
    url="https://chromewebstore.google.com/detail/linkedspace/accppdjdjgghpmlmpjpepldlahcfngbf"
    badge="Tool"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Games</div>
  </div>

  <HorizontalCard
    title="Cat basketball by Mon (2023)"
    img="/post_img.webp"
    desc="A tiny cat basketball game."
    url="/cat_basketball.html"
    target="_self"
    badge="Game"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">In Vietnamese</div>
  </div>

  <HorizontalCard
    title="Tính lương Gross <-> Net & Phí chuyển nhượng bất động sản"
    img="/post_img.webp"
    desc="Gross-to-Net salary converter and real estate transfer fee calculator."
    url="https://clessvna-viva-utileco.hf.space"
    badge="VN"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Phân loại tin bất động sản"
    img="/post_img.webp"
    desc="Real estate news classifier."
    url="https://liberifatali.github.io/takecopter"
    badge="VN"
  />
</BaseLayout>